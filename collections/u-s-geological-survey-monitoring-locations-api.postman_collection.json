      "item": [
        {
          "id": "bf49ddd1-f81a-433f-b59b-c900b8fe7ba1",
          "name": "USGS Water Data Get Monitoring Locations",
          "request": {
            "name": "USGS Water Data Get Monitoring Locations",
            "description": {
              "content": "Retrieve USGS water monitoring locations (stream gages, groundwater wells, springs, etc.) as GeoJSON features. Supports spatial filtering by bounding box, attribute filtering by state/county/HUC, and pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "collections",
                "monitoring-locations",
                "items"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "bbox",
                  "value": "<string>",
                  "description": "Bounding box spatial filter as [min_lon,min_lat,max_lon,max_lat]. Optionally include min_elev and max_elev for 6-coordinate form."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Number of results to return (default 100, max 10000)."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Starting offset for pagination."
                },
                {
                  "disabled": false,
                  "key": "f",
                  "value": "json",
                  "description": "Output format (json, html, jsonld, csv)."
                },
                {
                  "disabled": false,
                  "key": "stateCd",
                  "value": "<string>",
                  "description": "Two-letter U.S. state or territory FIPS code (e.g., CA, TX, NY)."
                },
                {
                  "disabled": false,
                  "key": "huc",
                  "value": "<string>",
                  "description": "Hydrologic Unit Code (2-12 digits) to filter by watershed."
                },
                {
                  "disabled": false,
                  "key": "siteType",
                  "value": "<string>",
                  "description": "USGS site type code (ST for streams, GW for groundwater, LK for lakes, AT for atmosphere, WE for wetlands, etc.)."
                },
                {
                  "disabled": false,
                  "key": "agencyCd",
                  "value": "<string>",
                  "description": "Agency code (default USGS)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
