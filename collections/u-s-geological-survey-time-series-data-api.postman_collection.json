    {
      "id": "ab258ae1-886d-4cf2-b27e-b1cdd30c24cd",
      "name": "Time Series Data",
      "description": {
        "content": "Continuous and daily value water data from USGS monitoring locations.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "450b297f-58be-45e6-ae37-8f662c211694",
          "name": "USGS Water Data Get Time Series",
          "request": {
            "name": "USGS Water Data Get Time Series",
            "description": {
              "content": "Retrieve USGS water data time series records including continuous sensor measurements (streamflow, stage, temperature, specific conductance, etc.) and daily values. Filter by monitoring location, parameter code, time range, and spatial extent.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "collections",
                "time-series",
                "items"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "bbox",
                  "value": "<string>",
                  "description": "Bounding box spatial filter as [min_lon,min_lat,max_lon,max_lat]. Optionally include min_elev and max_elev for 6-coordinate form."
                },
                {
                  "disabled": false,
                  "key": "time",
                  "value": "<string>",
                  "description": "Temporal filter in RFC 3339 or ISO 8601 format. Use a single datetime or interval (e.g., 2025-01-01/2025-03-01)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Number of results to return (default 100, max 10000)."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Starting offset for pagination."
                },
                {
                  "disabled": false,
                  "key": "f",
                  "value": "json",
                  "description": "Output format (json, html, jsonld, csv)."
                },
                {
                  "disabled": false,
                  "key": "monitoringLocationIdentifier",
                  "value": "<string>",
                  "description": "Filter by specific monitoring location identifier (e.g., USGS-11169025)."
                },
                {
                  "disabled": false,
                  "key": "observedPropertyId",
                  "value": "<string>",
                  "description": "USGS parameter code for the measured property (e.g., 00060 for streamflow in cfs, 00065 for gage height in feet)."
                },
                {
                  "disabled": false,
                  "key": "statistic",
                  "value": "<string>",
                  "description": "Statistic code for daily values (00001=max, 00002=min, 00003=mean)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
